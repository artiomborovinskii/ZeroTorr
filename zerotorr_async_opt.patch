diff -urN a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml	2026-11-03 12:00:00.000000000 +0000
+++ b/Cargo.toml	2026-11-05 12:00:00.000000000 +0000
@@ -43,6 +43,20 @@
