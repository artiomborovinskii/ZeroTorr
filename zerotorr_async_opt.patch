diff -urN a/src/main.rs b/src/main.rs
--- a/src/main.rs	2026-11-03 12:00:00.000000000 +0000
+++ b/src/main.rs	2026-11-05 12:00:00.000000000 +0000
@@ -28,9 +28,19 @@
     let low_memory = std::env::args().any(|a| a == "--low-memory");
 
     // Настройка асинхронного рантайма под архитектуру SoC
-    let workers = if low_memory { 2 } else { num_cpus::get().min(4) };
+    // На 4-ядерном Amlogic оставляем ядра под Алису и системный звук,
+    // предотвращая starvation аудио-демонов и минимизируя переключения контекста.
+    let workers = if low_memory { 2 } else { 3 };
+    let max_blocking = if low_memory { 4 } else { 8 };
+
     let runtime = tokio::runtime::Builder::new_multi_thread()
         .worker_threads(workers)
+        .max_blocking_threads(max_blocking)
+        .thread_stack_size(1024 * 1024) // 1 МБ стек (защита от ulimit -s 1024 на станции)
+        .thread_name("zt-async")
         .enable_all()
         .build()?;
 
diff -urN a/src/api.rs b/src/api.rs
--- a/src/api.rs	2026-11-03 12:00:00.000000000 +0000
+++ b/src/api.rs	2026-11-05 12:00:00.000000000 +0000
@@ -120,6 +120,11 @@
     // В цикле отдачи стрима плееру:
     // Потоковая отдача нулевыми срезами Bytes + кооперативный yield воркера Tokio
     let stream = async_stream::stream! {
         while let Some(chunk) = pump.next_chunk().await? {
+            // Кооперативная уступка кванта времени планировщику Tokio:
+            // Гарантирует, что тяжелая отдача HTTP-трафика не заблокирует
+            // обработку входящих P2P-пакетов и таймеров даже на 2 ядрах.
+            tokio::task::yield_now().await;
+            yield Ok(http_body::Frame::data(chunk));
         }
     };
