 debug = false
 incremental = false
+
+# Аппаратные горячие циклы ускоряем до максимума, пока весь бинарник сжат по размеру:
+[profile.release.package.sha1]
+opt-level = 3
+
+[profile.release.package.sha2]
+opt-level = 3
+
+[profile.release.package.crc32fast]
+opt-level = 3
+
+[profile.release.package.miniz_oxide]
+opt-level = 3
